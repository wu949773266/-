.outdoor-mbti {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 28rpx 56rpx;
  color: #18231d;
  background:
    linear-gradient(180deg, rgba(229, 238, 218, 0.96), rgba(246, 242, 229, 0.98)),
    #edf1e5;
}

.hero {
  padding: 20rpx 4rpx 32rpx;
}

.eyebrow {
  color: #6b7b43;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.title {
  margin-top: 14rpx;
  font-size: 56rpx;
  line-height: 1.08;
  font-weight: 800;
}

.subtitle {
  margin-top: 16rpx;
  color: #506050;
  font-size: 28rpx;
  line-height: 1.5;
}

.panel,
.result-panel {
  border: 2rpx solid rgba(59, 81, 53, 0.16);
  border-radius: 16rpx;
  padding: 28rpx;
  background: rgba(255, 252, 242, 0.9);
  box-shadow: 0 20rpx 50rpx rgba(35, 49, 33, 0.1);
}

.progress-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  padding: 0;
  border-radius: 50%;
  color: #263728;
  background: #e0e8d3;
  font-size: 48rpx;
  line-height: 66rpx;
}

.icon-btn[disabled] {
  color: #98a08e;
  background: #edf0e7;
}

.progress-wrap {
  flex: 1;
}

.progress-meta {
  display: flex;
  justify-content: space-between;
  color: #66705f;
  font-size: 24rpx;
}

.progress-track {
  overflow: hidden;
  height: 14rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: #dce3d2;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #47663f, #c1793a);
  transition: width 180ms ease;
}

.question {
  margin-top: 42rpx;
  font-size: 40rpx;
  line-height: 1.32;
  font-weight: 800;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 34rpx;
}

.option {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 132rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(71, 102, 63, 0.18);
  border-radius: 14rpx;
  color: #1e2b20;
  background: #fffaf0;
  text-align: left;
}

.option-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  min-width: 54rpx;
  border-radius: 50%;
  color: #fffaf0;
  background: #47663f;
  font-size: 24rpx;
  font-weight: 700;
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.42;
}

.type-code {
  color: #c1793a;
  font-size: 34rpx;
  font-weight: 900;
}

.result-name {
  margin-top: 10rpx;
  font-size: 52rpx;
  line-height: 1.12;
  font-weight: 900;
}

.result-role {
  margin-top: 14rpx;
  color: #47663f;
  font-size: 28rpx;
  font-weight: 700;
}

.result-summary {
  margin-top: 24rpx;
  color: #3f4d42;
  font-size: 30rpx;
  line-height: 1.55;
}

.insight-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 32rpx;
}

.insight {
  padding: 22rpx;
  border-left: 8rpx solid #47663f;
  border-radius: 8rpx;
  background: rgba(224, 232, 211, 0.7);
}

.label {
  display: block;
  color: #6b7b43;
  font-size: 22rpx;
  font-weight: 800;
}

.value {
  display: block;
  margin-top: 8rpx;
  color: #263728;
  font-size: 28rpx;
  line-height: 1.45;
}

.restart {
  margin-top: 34rpx;
  height: 92rpx;
  border-radius: 999rpx;
  color: #fffaf0;
  background: #263728;
  font-size: 30rpx;
  font-weight: 800;
}
