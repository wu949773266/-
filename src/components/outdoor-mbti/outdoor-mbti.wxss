/* ===== 全局容器 ===== */
.outdoor-mbti {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 60rpx 32rpx 80rpx;
  color: #1a2e22;
  background:
    linear-gradient(135deg, rgba(47, 111, 79, 0.08) 0%, rgba(229, 238, 218, 0.15) 50%, rgba(246, 242, 229, 0.08) 100%),
    linear-gradient(180deg, rgba(249, 247, 240, 0.96) 0%, rgba(245, 241, 235, 0.98) 100%);
  animation: fadeIn 0.6s ease-out;
}

/* ===== 动画定义 ===== */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.05);
    opacity: 0.9;
  }
}

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

/* ===== 头部区域 ===== */
.hero {
  padding: 32rpx 0 40rpx;
  animation: fadeIn 0.8s ease-out 0.1s both;
}

.eyebrow {
  display: inline-block;
  color: #5a7a5a;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  background: linear-gradient(90deg, #47663f, #c1793a);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(71, 102, 63, 0.1);
  -webkit-background-clip: border-box;
  background-clip: border-box;
  color: #5a7a5a;
}

.title {
  margin-top: 20rpx;
  font-size: 68rpx;
  line-height: 1.1;
  font-weight: 800;
  background: linear-gradient(135deg, #263728 0%, #47663f 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow: 0 2rpx 8rpx rgba(38, 55, 40, 0.1);
}

.subtitle {
  margin-top: 20rpx;
  color: #5a6a5a;
  font-size: 30rpx;
  line-height: 1.6;
  font-weight: 400;
  opacity: 0.9;
}

/* ===== 卡片面板 ===== */
.panel,
.result-panel {
  border: none;
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  box-shadow:
    0 8rpx 32rpx rgba(38, 55, 40, 0.08),
    0 2rpx 8rpx rgba(38, 55, 40, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  animation: slideUp 0.8s ease-out 0.2s both;
  position: relative;
  overflow: hidden;
}

.panel::before,
.result-panel::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #47663f, #c1793a, #47663f);
  background-size: 200% 100%;
  animation: shimmer 3s ease-in-out infinite;
}

/* ===== 进度区域 ===== */
.progress-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.icon-btn {
  width: 80rpx;
  height: 80rpx;
  min-width: 80rpx;
  padding: 0;
  border-radius: 50%;
  color: #263728;
  background: linear-gradient(135deg, #e8f0e1 0%, #d4e0c9 100%);
  font-size: 48rpx;
  line-height: 72rpx;
  box-shadow:
    0 4rpx 12rpx rgba(71, 102, 63, 0.15),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.5);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.icon-btn[disabled] {
  color: #9aa898;
  background: linear-gradient(135deg, #f5f5f0 0%, #ebe8e0 100%);
  box-shadow: none;
}

.icon-btn:not([disabled]):active {
  transform: scale(0.95);
  box-shadow:
    0 2rpx 8rpx rgba(71, 102, 63, 0.2),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.5);
}

.progress-wrap {
  flex: 1;
}

.progress-meta {
  display: flex;
  justify-content: space-between;
  color: #6a7a6a;
  font-size: 26rpx;
  font-weight: 500;
}

.progress-track {
  overflow: hidden;
  height: 16rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #e8f0e1 0%, #d4e0c9 100%);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #47663f 0%, #6b8f5f 50%, #c1793a 100%);
  box-shadow:
    0 2rpx 8rpx rgba(71, 102, 63, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.progress-fill::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4));
  border-radius: 999rpx;
}

/* ===== 题目区域 ===== */
.question {
  margin-top: 48rpx;
  font-size: 44rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #263728;
  animation: slideUp 0.6s ease-out 0.3s both;
}

/* ===== 选项区域 ===== */
.options {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 40rpx;
}

.option {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 140rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  color: #1e2b20;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  text-align: left;
  box-shadow:
    0 4rpx 16rpx rgba(38, 55, 40, 0.06),
    0 1rpx 4rpx rgba(38, 55, 40, 0.03);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  animation: slideUp 0.5s ease-out both;
}

.option:nth-child(1) { animation-delay: 0.4s; }
.option:nth-child(2) { animation-delay: 0.45s; }

.option::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(71, 102, 63, 0.05) 0%, transparent 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.option:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.9);
  box-shadow:
    0 8rpx 24rpx rgba(71, 102, 63, 0.12),
    0 2rpx 8rpx rgba(71, 102, 63, 0.06);
}

.option:active::before {
  opacity: 1;
}

.option-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  min-width: 60rpx;
  border-radius: 16rpx;
  color: #fffaf0;
  background: linear-gradient(135deg, #47663f 0%, #5a7f50 100%);
  font-size: 26rpx;
  font-weight: 700;
  box-shadow:
    0 4rpx 12rpx rgba(71, 102, 63, 0.25),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.2);
  position: relative;
  z-index: 1;
}

.option-text {
  flex: 1;
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 500;
  color: #2a3a2a;
  position: relative;
  z-index: 1;
}

/* ===== 结果页面 ===== */
.type-code {
  display: inline-block;
  color: #c1793a;
  font-size: 36rpx;
  font-weight: 900;
  background: linear-gradient(135deg, rgba(193, 121, 58, 0.1) 0%, rgba(193, 121, 58, 0.05) 100%);
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(193, 121, 58, 0.2);
  animation: slideUp 0.6s ease-out 0.2s both;
}

.result-name {
  margin-top: 16rpx;
  font-size: 60rpx;
  line-height: 1.1;
  font-weight: 900;
  background: linear-gradient(135deg, #263728 0%, #47663f 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: slideUp 0.6s ease-out 0.3s both;
}

.result-role {
  display: inline-block;
  margin-top: 20rpx;
  color: #47663f;
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, rgba(71, 102, 63, 0.1) 0%, rgba(71, 102, 63, 0.05) 100%);
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  animation: slideUp 0.6s ease-out 0.4s both;
}

.result-summary {
  margin-top: 32rpx;
  color: #3f4d42;
  font-size: 32rpx;
  line-height: 1.6;
  font-weight: 400;
  padding: 28rpx;
  background: rgba(71, 102, 63, 0.04);
  border-radius: 16rpx;
  border-left: 6rpx solid #47663f;
  animation: slideUp 0.6s ease-out 0.5s both;
}

.insight-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 40rpx;
}

.insight {
  padding: 28rpx 32rpx;
  border: 2rpx solid rgba(71, 102, 63, 0.12);
  border-radius: 20rpx;
  background: rgba(249, 247, 240, 0.6);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
  animation: slideUp 0.5s ease-out both;
}

.insight:nth-child(1) { animation-delay: 0.6s; }
.insight:nth-child(2) { animation-delay: 0.65s; }
.insight:nth-child(3) { animation-delay: 0.7s; }

.insight:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 20rpx rgba(71, 102, 63, 0.1);
}

.label {
  display: block;
  color: #6b7b43;
  font-size: 24rpx;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.value {
  display: block;
  color: #263728;
  font-size: 30rpx;
  line-height: 1.5;
  font-weight: 400;
}

/* ===== 重新开始按钮 ===== */
.restart {
  margin-top: 48rpx;
  height: 100rpx;
  border-radius: 50rpx;
  color: #fffaf0;
  background: linear-gradient(135deg, #263728 0%, #47663f 100%);
  font-size: 32rpx;
  font-weight: 800;
  box-shadow:
    0 8rpx 24rpx rgba(38, 55, 40, 0.25),
    0 2rpx 8rpx rgba(38, 55, 40, 0.15),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.15);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  animation: slideUp 0.6s ease-out 0.8s both;
}

.restart::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.restart:active {
  transform: scale(0.96);
  box-shadow:
    0 4rpx 12rpx rgba(38, 55, 40, 0.3),
    0 1rpx 4rpx rgba(38, 55, 40, 0.2);
}

.restart:active::before {
  left: 100%;
}
